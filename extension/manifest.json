{
  "manifest_version": 3,
  "name": "foxlens demo",
  "version": "0.1.1",
  "description": "See a page as an image when the DOM is not enough: screenshot plus a vision model.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxlens@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "foxlens demo",
    "default_popup": "panel.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "trialML"
  ],
  "sidebar_action": {
    "default_title": "foxlens demo",
    "default_panel": "panel.html"
  }
}
